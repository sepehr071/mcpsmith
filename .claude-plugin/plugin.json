{
  "name": "mcpsmith",
  "displayName": "mcpsmith",
  "version": "0.3.0",
  "description": "Turn an OpenAPI file or a recorded website session into a curated, tested MCP server. Skills and an MCP server for your coding agent.",
  "author": {
    "name": "Sepehr Radmard",
    "email": "sepehrr80@gmail.com",
    "url": "https://github.com/sepehr071"
  },
  "homepage": "https://github.com/sepehr071/mcpsmith",
  "repository": "https://github.com/sepehr071/mcpsmith",
  "license": "MIT",
  "keywords": [
    "mcp",
    "openapi",
    "har",
    "code-generation",
    "mcp-server",
    "agents"
  ],
  "mcpServers": {
    "mcpsmith": {
      "command": "uvx",
      "args": [
        "mcpsmith@0.3.0",
        "mcp"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.11.0",
        "--browser-url=http://127.0.0.1:9222"
      ]
    },
    "rea": {
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@6.7.0",
        "mcp"
      ]
    }
  }
}
