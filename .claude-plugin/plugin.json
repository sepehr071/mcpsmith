{
  "name": "toolsmelt",
  "displayName": "toolsmelt",
  "version": "0.8.0",
  "description": "Turn an OpenAPI file, a website, an app, a Postman collection or a database into curated, tested MCP tools. Skills and an MCP server for your coding agent.",
  "author": {
    "name": "Sepehr Radmard",
    "email": "sepehrr80@gmail.com",
    "url": "https://github.com/sepehr071"
  },
  "homepage": "https://github.com/sepehr071/toolsmelt",
  "repository": "https://github.com/sepehr071/toolsmelt",
  "license": "MIT",
  "keywords": [
    "mcp",
    "openapi",
    "har",
    "code-generation",
    "mcp-server",
    "agents"
  ],
  "mcpServers": {
    "toolsmelt": {
      "command": "uvx",
      "args": [
        "toolsmelt@0.8.0",
        "mcp"
      ]
    },
    "toolsmelt-chrome": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.11.0",
        "--browser-url=http://127.0.0.1:9222"
      ]
    }
  }
}
