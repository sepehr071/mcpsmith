@pytest.fixture(autouse=True)
def fresh_http_client(monkeypatch):
    """The HTTP client is bound to one event loop; each test gets a new loop."""
    if SQL or GRPC:
        yield
        return
    monkeypatch.setattr(api, "RETRY_DELAY", 0)
    monkeypatch.setattr(api, "JITTER", (0, 0))
    api.set_transport(None)
    yield
    api.set_transport(None)


@pytest.fixture
def replay(monkeypatch):
    """Answer every request with the saved response tests/fixtures/<name>.json."""

    def use(name: str) -> None:
        body = json.loads((FIXTURES / f"{name}.json").read_text(encoding="utf-8"))
        if SQL:  # the saved rows; the read-only check still runs before
            monkeypatch.setattr(api, "fetch", lambda sql, params, read_only, max_rows: body[:max_rows])
            return
        if GRPC:  # the saved response message
            monkeypatch.setattr(api, "invoke", lambda name, request, metadata: body)
            return
        if SIGNIN:  # the provider signs each request and may encrypt the answer
            from toolsmelt.runtime import signin

            monkeypatch.setenv(AUTH_ENV, signin.test_session(SIGNIN))
            api.set_transport(httpx.MockTransport(lambda request: signin.fake_reply(SIGNIN, request, body)))
            return
        api.set_transport(httpx.MockTransport(lambda request: httpx.Response(200, json=body)))
        if AUTH_ENV and not os.environ.get(AUTH_ENV):
            monkeypatch.setenv(AUTH_ENV, "test")

    return use


