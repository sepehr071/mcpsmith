{
  "info": {
    "name": "No Host",
    "schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json"
  },
  "item": [
    {
      "name": "List notes",
      "request": {
        "method": "GET",
        "header": "Accept: application/json\nX-Session-Token: FAKESESSION0123456789",
        "url": "{{host}}/notes?limit=10"
      }
    },
    {
      "name": "Get note",
      "request": "{{host}}/notes/{{noteId}}"
    }
  ]
}
